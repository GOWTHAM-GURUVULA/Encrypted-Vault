{
  "name": "encrypted-vault",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.cjs",

  "scripts": {
    "dev": "vite",
    "electron:dev": "concurrently \"vite\" \"electron .\"",
    "build": "vite build",
    "electron:build": "npm run build && electron-builder"
  },

  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },

  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "vite": "^5.0.0",
    "electron": "^30.0.0",
    "concurrently": "^8.2.0",
    "electron-builder": "^24.13.3"
  },

  "build": {
    "appId": "com.encrypted.vault",
    "productName": "Encrypted Vault",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "icon": "electron/vault.ico",
      "target": "nsis"
    }
  }
}
