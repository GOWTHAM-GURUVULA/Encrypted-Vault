{
  "name": "encrypted-vault",
  "version": "1.2.7",
  "description": "Secure local file encryption vault",
  "author": {
    "name": "Gowtham"
  },
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "electron": "cmd /c \"set ELECTRON_RUN_AS_NODE=&& electron .\"",
    "electron:dev": "concurrently \"vite\" \"cmd /c \\\"set ELECTRON_RUN_AS_NODE=&& electron .\\\"\"",
    "build": "vite build",
    "electron:build": "npm run build && electron-builder",
    "electron:sign": "powershell -ExecutionPolicy Bypass -File .\\scripts\\sign-installer.ps1",
    "electron:release:signed": "npm run electron:build && npm run electron:sign"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^8.2.0",
    "electron": "^40.0.3",
    "electron-builder": "^26.8.1",
    "vite": "^8.0.1"
  },
  "build": {
    "appId": "com.encryptedvault.app",
    "productName": "Encrypted Vault",
    "asar": true,
    "compression": "maximum",
    "electronDist": "node_modules/electron/dist",
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!**/*.map",
      "!**/README*",
      "!**/CHANGELOG*"
    ],
    "extraResources": [
      {
        "from": "../../backend/dist/app.exe",
        "to": "backend/app.exe"
      }
    ],
    "win": {
      "icon": "electron/vault.ico",
      "target": "nsis"
    }
  }
}
